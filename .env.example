# Copy this file to .env and paste your PRACTICE account keys after the = signs.
# Never share .env or paste these keys into a chat.

# Alpaca paper: https://app.alpaca.markets -> switch to Paper -> API Keys -> Generate
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# OANDA practice: https://www.oanda.com -> demo account -> Manage API Access -> Generate
# Account ID looks like 101-001-1234567-001 (shown on the practice account page)
OANDA_TOKEN=
OANDA_ACCOUNT_ID=

# Binance spot testnet: https://testnet.binance.vision -> log in with GitHub -> Generate HMAC_SHA256 Key
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
